# Application & Database
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2

# Telegram Bot & Authentication
BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Telegram User Client (Telethon for channel ingestion)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=tg_summariser
TELEGRAM_SESSION_STRING=
TELEGRAM_SYNC_DELAY_SECONDS=15
TELEGRAM_CHANNEL_SYNC_TIMEOUT_SECONDS=45

# OpenAI & AI Processing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional for OpenAI-compatible providers, for example https://provider.example/v1
OPENAI_BASE_URL=
# Use chat_completions for providers without the OpenAI Responses API
OPENAI_API_MODE=responses
AI_PROCESSING_LIMIT_PER_RUN=20
AI_BATCH_SIZE=5
OPENAI_BATCH_ENABLED=false
OPENAI_BATCH_POST_LIMIT=100
AI_MIN_TEXT_LENGTH=120
AI_MAX_INPUT_CHARS=3000
AI_PREFILTER_ENABLED=true
AI_PREFILTER_STRICT=true
AI_PREFILTER_POSITIVE_KEYWORDS=ai,ии,llm,gpt,openai,anthropic,claude,agent,agents,агент,агенты,бизнес,startup,стартап,saas,инвестиции,product,продукт
AI_PREFILTER_NEGATIVE_KEYWORDS=реклама,промо,скидка,подписывайтесь,подписаться,курс,вебинар,розыгрыш,донат,вакансия,нанимаем,advertisement,advertising,promo,sponsored,discount,subscribe,webinar,course,giveaway,vacancy,hiring

# Product Radar
PRODUCT_RADAR_ENABLED=true
PRODUCT_RADAR_MIN_SCORE=0.65

# Digest & Onboarding Scheduling
TIMEZONE=Europe/Lisbon
DIGEST_SCHEDULES=09:00,14:00,19:00
DIGEST_MAX_POST_AGE_DAYS=3
DIGEST_MIN_IMPORTANCE_SCORE=0.5
DIGEST_MIN_RELEVANCE_SCORE=0.65
CHANNEL_ONBOARDING_MAX_POST_AGE_DAYS=7

# TG Articles Integration (External Database Source)
TGARTICLES_DATABASE_URL=
TGARTICLES_IMPORT_ENABLED=true
TGARTICLES_IMPORT_DAYS=3
TGARTICLES_IMPORT_LIMIT=50
TGARTICLES_MIN_TEXT_LENGTH=900
TGARTICLES_SOURCE_CHAT_ID=910000001
TGARTICLES_IMPORT_SCHEDULES=08:30,11:30,14:30,17:30,20:30
